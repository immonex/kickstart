{
  "presets": [
    ["@babel/preset-env", {
      "modules": "auto", // false
      "corejs": "3.50",
      "targets": "defaults",
      "debug": false
    }]
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    ["polyfill-corejs3", {
      "method": "usage-global",
      "version": "3.50",
      "proposals": true
    }]
  ]
}